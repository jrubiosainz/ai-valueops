# The offline demo needs none of these values.
# Optional operator workflow only. Use your own authorized Azure scope.
# Node 20.6+: node --env-file=.env scripts/evaluate.mjs --live
AZURE_SUBSCRIPTION_ID=YOUR_SUBSCRIPTION_ID
AZURE_TENANT_ID=YOUR_TENANT_ID
AZURE_RESOURCE_GROUP=rg-ai-valueops
AZURE_OPENAI_ACCOUNT=YOUR_RESOURCE_NAME
AZURE_OPENAI_ENDPOINT=https://YOUR_RESOURCE_NAME.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT=valueops-qa
AZURE_ACCOUNT_REGION=westeurope

# Explicit opt-ins. Leave false for the demo, build, tests and context tools.
AI_VALUEOPS_ALLOW_INFERENCE=false
AI_VALUEOPS_ALLOW_PROVISIONING=false

# Used only when intentionally provisioning the optional Bicep template.
AZURE_RESOURCE_SUFFIX=YOUR_UNIQUE_SUFFIX
AZURE_MODEL_CAPACITY=1

# The local viewer always binds to loopback.
PORT=4311
